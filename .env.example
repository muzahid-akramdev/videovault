# Copy this file to .env for local runs, or set these as environment
# variables in your Render/Railway dashboard for deployment.

# The passcode your friends/family will enter to access the site.
# Pick something you can share verbally/in a text — not your Facebook password.
SITE_PASSCODE=change-me-to-something-only-your-group-knows

# Port the server listens on (Render/Railway set this automatically —
# you usually don't need to set it yourself in production)
PORT=3001
